# Source this before running stage 1 for a quick smoke-sized sample:
#   set -a; source configs/sample.env; set +a
#
# Narrow snapshot range + hard limits keep the download/extract stage fast
# enough to validate the pipeline end-to-end before scaling up.

export START_SNAPSHOT=2024-46
export END_SNAPSHOT=2024-46
export URL_LIMIT=2
export RECORD_LIMIT=500
export LANGUAGES=EN
